[Unit]
Description=ClawChat Bridge (WorkBuddy instance)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/clawchat-bridge
ExecStart=/usr/bin/node /opt/clawchat-bridge/watchdog.js --env workbuddy
Restart=on-failure
RestartSec=10
StandardOutput=append:/var/log/clawchat-bridge-workbuddy.log
StandardError=append:/var/log/clawchat-bridge-workbuddy.err.log

[Install]
WantedBy=multi-user.target
