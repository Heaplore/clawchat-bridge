# ===== ClawChat 配置 (WebSocket Bridge v2) =====
CLAWCHAT_BASE_URL=https://app.clawling.com
CLAWCHAT_WEBSOCKET_URL=wss://app.clawling.com/ws
CLAWCHAT_MEDIA_UPLOAD_URL=

# ===== 激活后得到的凭据 =====
CLAWCHAT_ACCESS_TOKEN=
CLAWCHAT_REFRESH_TOKEN=
CLAWCHAT_DEVICE_ID=
CLAWCHAT_AGENT_ID=
CLAWCHAT_OWNER_USER_ID=

# ===== LLM 配置 (doubao | deepseek | openai-compatible) =====
LLM_PROVIDER=doubao
LLM_API_KEY=your_llm_api_key
LLM_MODEL=doubao-seed-1.6
LLM_API_BASE=

# ===== 安全策略 =====
DM_POLICY=all
DM_ALLOWLIST=
GROUP_ALLOWLIST=
REQUIRE_MENTION_IN_GROUP=true

# ===== Bridge 服务配置 =====
BRIDGE_INSTANCE=default
AGENT_WORKDIR=/workspace
PORT=3000
HOST=0.0.0.0
CONTEXT_WINDOW=20
