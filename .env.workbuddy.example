# ===== ClawChat 配置 - WorkBuddy Bridge 实例 =====
CLAWCHAT_BASE_URL=https://app.clawling.com
CLAWCHAT_WEBSOCKET_URL=wss://app.clawling.com/ws
CLAWCHAT_MEDIA_UPLOAD_URL=

# ===== WorkBuddy 实例激活凭据 =====
CLAWCHAT_ACCESS_TOKEN=
CLAWCHAT_REFRESH_TOKEN=
CLAWCHAT_DEVICE_ID=
CLAWCHAT_AGENT_ID=
CLAWCHAT_OWNER_USER_ID=

# ===== LLM 配置 - WorkBuddy 模型 =====
LLM_PROVIDER=deepseek
LLM_API_KEY=your_llm_api_key
LLM_MODEL=deepseek-chat
LLM_API_BASE=

# ===== 安全策略 =====
DM_POLICY=all
DM_ALLOWLIST=
GROUP_ALLOWLIST=
REQUIRE_MENTION_IN_GROUP=true

# ===== Bridge 服务配置 =====
BRIDGE_INSTANCE=workbuddy
AGENT_WORKDIR=/path/to/workbuddy/workspace
PORT=3002
HOST=0.0.0.0
CONTEXT_WINDOW=20
